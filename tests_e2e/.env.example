# Copy this file to .env (gitignored) and fill in your own values.
# Everything here has a sensible fallback except the device needing to
# actually be connected -- see tests_e2e/README.md for full setup.

# adb serial to target. Leave blank to auto-select if exactly one device
# is connected (fails loudly if zero or more than one are connected).
E2E_ADB_SERIAL=

# Path to the adb binary. Leave as "adb" if it's on your PATH, otherwise
# point at $ANDROID_HOME/platform-tools/adb.
E2E_ADB_PATH=adb

# Path to a prebuilt debug APK to install before the suite runs. Leave
# blank to skip installation and assume the app is already installed
# (e.g. you just ran scripts/dev_deploy.sh yourself).
E2E_APK_PATH=

# Your Polar device's id (as shown in the app / STATUS output), e.g.
# "156AC536". Only used for a friendlier assertion message -- the suite
# never requires a specific device, just *a* Polar in range that the
# phone has previously paired with (or DEFAULT_DEVICE_ID baked into the
# APK -- see app/build.gradle.kts).
E2E_POLAR_DEVICE_ID=

# Your ppg-pi-server URL + bearer token, for the sync test. Leave blank
# to skip sync-dependent tests (they'll be skipped, not failed).
E2E_SERVER_URL=
E2E_SERVER_TOKEN=
