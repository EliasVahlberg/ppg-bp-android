<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      BLE permissions for Android 12+. The legacy ACCESS_FINE_LOCATION
      pre-12 permission is intentionally omitted because we set minSdk to 33.

      BLUETOOTH_SCAN: required to discover BLE devices.
      BLUETOOTH_CONNECT: required to connect/communicate with BLE devices.
      We declare neverForLocation on BLUETOOTH_SCAN since we don't derive
      device location from scan results — this avoids prompting for the
      runtime FINE_LOCATION permission.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service for long-running recording sessions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Upload session bundles to ppg-pi-server (LAN/Tailscale, plain HTTP). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_camera"
        android:roundIcon="@android:drawable/ic_menu_camera"
        android:theme="@style/Theme.PolarBpRecorder"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>
</manifest>
