<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      BLE permissions for Android 12+. The legacy ACCESS_FINE_LOCATION
      pre-12 permission is intentionally omitted because we set minSdk to 33.

      BLUETOOTH_SCAN: required to discover BLE devices.
      BLUETOOTH_CONNECT: required to connect/communicate with BLE devices.
      We declare neverForLocation on BLUETOOTH_SCAN since we don't derive
      device location from scan results — this avoids prompting for the
      runtime FINE_LOCATION permission.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service for long-running recording sessions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BODY_SENSORS used to be declared here purely to satisfy the
         foregroundServiceType="health" permission check, with a comment admitting
         the app never reads the phone's own sensors. That was wrong in a way that
         crashed the app: BODY_SENSORS is foreground-only on API 33+ (background
         access needs the separate BODY_SENSORS_BACKGROUND grant), so the system
         evaluates it as *denied* whenever the app has no visible UI. Starting a
         recording from the background therefore threw

             SecurityException: Starting FGS with type health ... requires
             permissions ... [ACTIVITY_RECOGNITION, BODY_SENSORS,
             HIGH_SAMPLING_RATE_SENSORS]

         which Android wraps in a RuntimeException that kills the process, and then
         START_STICKY brings the service back so the crash repeats. Reproduced
         2026-07-27 on OxygenOS 14 by pressing HOME and broadcasting a start.

         The type was also simply inaccurate. This service exists to hold a link to
         an external BLE sensor, which is what "connectedDevice" describes, and its
         permission (BLUETOOTH_CONNECT) is not foreground-restricted. The app now
         declares no sensor permission it does not use, and one fewer runtime
         prompt has to be granted during setup. -->

    <!-- Battery-optimization exemption request (#4). Not a runtime
         permission, but the Intent it launches (Settings.ACTION_REQUEST_
         IGNORE_BATTERY_OPTIMIZATIONS) requires this manifest permission. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Upload session bundles to ppg-pi-server (LAN/Tailscale, plain HTTP). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PolarBpRecorder"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
